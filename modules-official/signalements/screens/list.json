{
  "screen": "list",
  "navigation": {
    "title": "Signalements",
    "displayMode": "inline"
  },
  "data": {
    "signalements": "firestore:signalements"
  },
  "view": {
    "type": "scroll",
    "refreshable": true,
    "children": [
      {
        "type": "vstack",
        "spacing": 0,
        "padding": 14,
        "children": [
          {
            "type": "card",
            "action": {
              "type": "navigate",
              "to": "propose"
            },
            "child": {
              "type": "hstack",
              "spacing": 12,
              "padding": 14,
              "align": "center",
              "children": [
                {
                  "type": "image",
                  "systemName": "plus.circle.fill",
                  "color": "civic",
                  "height": 22
                },
                {
                  "type": "vstack",
                  "spacing": 2,
                  "children": [
                    {
                      "type": "text",
                      "value": "Signaler un problème",
                      "style": "serif-title2"
                    },
                    {
                      "type": "text",
                      "value": "Voirie · éclairage · propreté · mobilier · espaces verts",
                      "style": "body",
                      "color": "secondary"
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      {
        "type": "vstack",
        "spacing": 18,
        "padding": 18,
        "children": [
          {
            "type": "for",
            "in": "signalements",
            "as": "sig",
            "child": {
              "type": "card",
              "action": {
                "type": "navigate",
                "to": "detail",
                "with": { "sig": "{{ sig }}" }
              },
              "child": {
                "type": "vstack",
                "spacing": 0,
                "children": [
                  {
                    "type": "image",
                    "url": "{{ sig.imageUrl }}",
                    "aspectRatio": 1.78
                  },
                  {
                    "type": "vstack",
                    "spacing": 6,
                    "padding": 14,
                    "children": [
                      {
                        "type": "text",
                        "value": "{{ sig.categoryLabel }}",
                        "style": "eyebrow",
                        "color": "terra"
                      },
                      {
                        "type": "text",
                        "value": "{{ sig.title }}",
                        "style": "serif-title2"
                      },
                      {
                        "type": "text",
                        "value": "{{ sig.address }}",
                        "style": "body",
                        "color": "secondary"
                      }
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    ]
  }
}
