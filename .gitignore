# macOS
.DS_Store

# IDE
.vscode/
.idea/
*.iml

# Build artifacts (any location)
**/build/
**/.build/
**/.gradle/
**/DerivedData/
**/xcuserdata/
**/*.xcuserstate
**/.swiftpm/
**/Pods/
**/venv/
**/__pycache__/

# xcodegen output (project.yml is the source of truth)
spike/ios/CommuneSpike.xcodeproj/
# Per-commune project file generated by tools/build-commune-app.sh from project.yml
spike/ios/project.commune.yml

# Per-commune sites générés par tools/build-commune-site.py (le _template
# reste committé, les sites matérialisés sont des outputs de build)
commune-sites/*/
!commune-sites/_template/
!commune-sites/README.md

# Android local dev
**/local.properties
**/captures/

# Firebase Hosting build output + cache
_site/
.firebase/

# Catalogue marketplace local pour le dashboard servi en localhost,
# regénéré par tools/build-marketplace.py (la copie déployée vit dans
# marketplace/public/data/manifests.json, committée et publiée par CI).
dashboard/manifests.json

# Secrets — Firebase configs are project-specific, set up locally per repo
GoogleService-Info.plist
google-services.json
dashboard/firebase-config-spike-*.json
.env
.env.local
.env.fastlane
*.keystore
*.jks
*.p8

# Fastlane runtime artefacts
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
spike/ios/build/fastlane/
